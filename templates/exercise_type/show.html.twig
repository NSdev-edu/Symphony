{% extends 'base.html.twig' %}

{% block title %}ExerciseType{% endblock %}

{% block body %}
    <h1>ExerciseType</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ exercise_type.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ exercise_type.name }}</td>
